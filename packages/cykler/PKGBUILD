_pkgname='cykler-shell'
pkgname="${_pkgname}-git"
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc='Personal Caelestia shell fork with additional features'
arch=('x86_64')
url='https://github.com/cykler01/cykler-caelestia'
license=('GPL-3.0-only')
depends=('quickshell-git' 'qt6-m3shapes-git'
         'ddcutil' 'brightnessctl' 'libpipewire' 'libqalculate'
         'networkmanager' 'lm_sensors' 'aubio' 
         'taglib' 'power-profiles-daemon'
         'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-multimedia'
         'swappy' 'fish' 'grim' 'slurp')
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools')
provides=($_pkgname 'caelestia-shell' 'caelestia-shell-git' 'midnight-shell' 'midnight-shell-git')
conflicts=($_pkgname 'caelestia-shell' 'caelestia-shell-git' 'midnight-shell' 'midnight-shell-git')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}"

  local version_args=()
  if ! git describe --tags --abbrev=0 >/dev/null 2>&1; then
    version_args+=(-DVERSION=0.0.0-fork)
  fi

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/ \
    "${version_args[@]}"
  cmake --build build
}

package() {
  cd "${srcdir}/${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}