#!/usr/bin/env bash
# Requires: bash git curl cmake ninja gcc make python3 python-pip sudo tar
# Vulkan: vulkan-radeon vulkan-headers vulkan-icd-loader shaderc spirv-tools
# SD.cpp UI: nodejs>=20 pnpm>=10 ; audio: ffmpeg ; AMD: /dev/kfd access
# System packages are NOT installed here. Run from Fish or Bash.
set -Eeuo pipefail

AI_HOME="${AI_HOME:-$HOME/Projects/AI}"
M="$AI_HOME/models"; A="$AI_HOME/apps"; R="/opt/therock/10.1.0"
ROCM_URL='https://stable.repo.amd.com/rocm/core/tarball/therock-dist-linux-gfx103X-all-10.1.0.tar.gz'
TORCH_INDEX='https://stable.repo.amd.com/rocm/whl-next/'
PYTHON_CMD="${PYTHON_CMD:-python3}"
JOBS="${AI_JOBS:-4}"

err() { echo "ai-install: $*" >&2; exit 1; }
msg() { echo "[ai-install] $*"; }
need() { command -v "$1" >/dev/null || err "missing: $1"; }
dirs() { mkdir -p "$A" "$AI_HOME/cache" "$AI_HOME/envs" "$AI_HOME/outputs/images" "$AI_HOME/outputs/audio" "$AI_HOME/logs" "$AI_HOME/run" "$M"/{lmstudio,checkpoints,diffusion_models,text_encoders,vae,whisper}; }
rocm_env() { env -u HSA_OVERRIDE_GFX_VERSION -u PYTORCH_ROCM_ARCH ROCM_PATH="$R" ROCM_HOME="$R" HIP_PATH="$R" "$@"; }
repo() {
  need git
  local url="$1" dst="$2"
  if [[ -d "$dst/.git" ]]; then
    [[ -z "$(git -C "$dst" status --porcelain --untracked-files=no)" ]] || err "local changes in $dst"
    git -C "$dst" pull --ff-only
    git -C "$dst" submodule update --init --recursive
  elif [[ -e "$dst" ]]; then err "not a Git checkout: $dst"
  else git clone --recursive "$url" "$dst"
  fi
}
# URLs are Hugging Face resolve URLs; only one representation of each model is
# downloaded into its category. Existing files are never overwritten.
get() {
  local repo="$1" file="$2" dest="$3" min_mb="$4" part size
  mkdir -p "$(dirname "$dest")"
  if [[ -f "$dest" ]]; then
    size=$(stat -c %s "$dest")
    (( size >= min_mb * 1000000 )) || err "undersized existing file: $dest"
    msg "present: ${dest#"$M/"}"; return
  fi
  need curl; part="$dest.part"
  msg "download: ${dest#"$M/"}"
  curl -fL --retry 5 --retry-delay 3 -C - \
    "https://huggingface.co/$repo/resolve/main/$file" -o "$part"
  size=$(stat -c %s "$part")
  (( size >= min_mb * 1000000 )) || err "incomplete download: $part"
  mv -- "$part" "$dest"
}
models() {
  dirs
  # Checkpoints
  get haven-ai-companion/dreamshaper8-lcm-gguf DreamShaper8_LCM_q8_0.gguf "$M/checkpoints/haven-ai-companion/dreamshaper8-lcm-gguf/DreamShaper8_LCM_q8_0.gguf" 500
  get Lykon/dreamshaper-8-lcm DreamShaper8_LCM.safetensors "$M/checkpoints/Lykon/dreamshaper-8-lcm/DreamShaper8_LCM.safetensors" 1000
  get stabilityai/stable-diffusion-xl-base-1.0 sd_xl_base_1.0.safetensors "$M/checkpoints/stabilityai/stable-diffusion-xl-base-1.0/sd_xl_base_1.0.safetensors" 3000
  get stable-diffusion-v1-5/stable-diffusion-v1-5 v1-5-pruned-emaonly.safetensors "$M/checkpoints/stable-diffusion-v1-5/stable-diffusion-v1-5/v1-5-pruned-emaonly.safetensors" 2000
  # Diffusion GGUF
  get JoyFusionAI/gguf-anima anima-turbo-v1.1-Q4_0.gguf "$M/diffusion_models/JoyFusionAI/gguf-anima/anima-turbo-v1.1-Q4_0.gguf" 500
  get leejet/Z-Image-Turbo-GGUF z_image_turbo-Q3_K.gguf "$M/diffusion_models/leejet/Z-Image-Turbo-GGUF/z_image_turbo-Q3_K.gguf" 2000
  # Encoders and VAEs
  get circlestone-labs/Anima split_files/text_encoders/qwen_3_06b_base.safetensors "$M/text_encoders/circlestone-labs/Anima/qwen_3_06b_base.safetensors" 500
  get JoyFusionAI/gguf-components Qwen3-0.6B-Base.Q8_0.gguf "$M/text_encoders/JoyFusionAI/gguf-components/Qwen3-0.6B-Base.Q8_0.gguf" 400
  get JoyFusionAI/gguf-components Qwen3-4B-Instruct-2507-Q4_0.gguf "$M/text_encoders/JoyFusionAI/gguf-components/Qwen3-4B-Instruct-2507-Q4_0.gguf" 1000
  get JoyFusionAI/gguf-components ae.safetensors "$M/vae/JoyFusionAI/gguf-components/ae.safetensors" 100
  get JoyFusionAI/gguf-components qwen_image_vae.safetensors "$M/vae/JoyFusionAI/gguf-components/qwen_image_vae.safetensors" 100
  # Speech GGUF: LM Studio does not manage these files
  local w
  for w in small medium large-v3-turbo; do
    get "handy-computer/whisper-$w-gguf" "whisper-$w-Q8_0.gguf" \
      "$M/whisper/whisper-$w-gguf/whisper-$w-Q8_0.gguf" 150
  done
}
rocm() {
  dirs; need sudo; need tar
  if [[ ! -x "$R/bin/hipcc" || ! -x "$R/bin/rocminfo" ]]; then
    [[ ! -e "$R" ]] || err "incomplete $R; inspect it first"
    local tarball="$AI_HOME/cache/therock-10.1.0-gfx103X.tar.gz" stage="/opt/therock/.staging-10.1.0-$$"
    if [[ ! -s "$tarball" ]]; then
      curl -fL --retry 5 -C - "$ROCM_URL" -o "$tarball.part"
      mv "$tarball.part" "$tarball"
    fi
    sudo mkdir -p "$stage"
    sudo tar -xzf "$tarball" -C "$stage"
    sudo test -x "$stage/bin/hipcc" || err "TheRock archive layout unexpected: $stage"
    sudo test -x "$stage/bin/rocminfo" || err "TheRock archive missing rocminfo: $stage"
    sudo mv "$stage" "$R"
  fi
  mkdir -p "$HOME/.config/environment.d" "$HOME/.config/fish/conf.d"
  cat > "$HOME/.config/environment.d/90-therock.conf" <<EOF
ROCM_PATH=$R
ROCM_HOME=$R
HIP_PATH=$R
EOF
  cat > "$HOME/.config/fish/conf.d/ai-therock.fish" <<EOF
fish_add_path -g '$R/bin'
set -gx ROCM_PATH '$R'
set -gx ROCM_HOME '$R'
set -gx HIP_PATH '$R'
EOF
  rocm_env "$R/bin/rocminfo" | grep -q 'gfx1032' || err 'gfx1032 not detected'
  msg "TheRock ready: $R (restart Fish)"
}
comfyui() {
  dirs; need "$PYTHON_CMD"
  [[ -x "$R/bin/hipcc" ]] || err 'run ai-install rocm first'
  repo https://github.com/Comfy-Org/ComfyUI.git "$A/ComfyUI"
  local v="$A/ComfyUI/.venv"
  [[ -x "$v/bin/python" ]] || "$PYTHON_CMD" -m venv "$v"
  "$v/bin/python" -m pip install -r "$A/ComfyUI/requirements.txt"
  [[ ! -f "$A/ComfyUI/manager_requirements.txt" ]] || "$v/bin/python" -m pip install -r "$A/ComfyUI/manager_requirements.txt"
  rocm_env "$v/bin/python" -m pip install --index-url "$TORCH_INDEX" \
    'torch[device-gfx1032]==2.13.0+rocm10.1.0' \
    'torchvision[device-gfx1032]==0.28.0+rocm10.1.0'
  rocm_env "$v/bin/python" -c 'import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.cuda.get_device_name(0))'
  # GGUF extension for supported diffusion models
  repo https://github.com/city96/ComfyUI-GGUF.git "$A/ComfyUI/custom_nodes/ComfyUI-GGUF"
  "$v/bin/python" -m pip install -r "$A/ComfyUI/custom_nodes/ComfyUI-GGUF/requirements.txt"
  cat > "$A/ComfyUI/extra_model_paths.yaml" <<EOF
ai:
  base_path: "$M"
  checkpoints: checkpoints
  diffusion_models: diffusion_models
  text_encoders: text_encoders
  vae: vae
EOF
  msg 'ComfyUI ready'
}
sdcpp() {
  dirs; need cmake; need node; need pnpm
  repo https://github.com/leejet/stable-diffusion.cpp.git "$A/stable-diffusion.cpp"
  cmake -S "$A/stable-diffusion.cpp" -B "$A/stable-diffusion.cpp/build-vulkan" \
    -DSD_VULKAN=ON -DSD_SERVER_BUILD_FRONTEND=ON -DCMAKE_BUILD_TYPE=Release
  cmake --build "$A/stable-diffusion.cpp/build-vulkan" -j "$JOBS"
}
lmcpp() {
  dirs; need cmake
  [[ -x "$R/bin/hipcc" ]] || err 'run ai-install rocm first'
  repo https://github.com/ggml-org/llama.cpp.git "$A/llama.cpp"
  cmake -S "$A/llama.cpp" -B "$A/llama.cpp/build-vulkan" -DGGML_VULKAN=ON -DCMAKE_BUILD_TYPE=Release
  cmake --build "$A/llama.cpp/build-vulkan" -j "$JOBS"
  rocm_env cmake -S "$A/llama.cpp" -B "$A/llama.cpp/build-hip" \
    -DGGML_HIP=ON -DGPU_TARGETS=gfx1032 -DCMAKE_PREFIX_PATH="$R" \
    -DCMAKE_HIP_COMPILER_ROCM_ROOT="$R" -DCMAKE_BUILD_TYPE=Release
  rocm_env cmake --build "$A/llama.cpp/build-hip" -j "$JOBS"
}
whisp() {
  dirs; need cmake
  repo https://github.com/handy-computer/transcribe.cpp.git "$A/transcribe.cpp"
  cmake -S "$A/transcribe.cpp" -B "$A/transcribe.cpp/build-vulkan" \
    -DTRANSCRIBE_VULKAN=ON -DCMAKE_BUILD_TYPE=Release
  cmake --build "$A/transcribe.cpp/build-vulkan" -j "$JOBS"
}
help() {
  echo 'ai-install {models|lmcpp|sdcpp|comfyui|rocm|whisp}'
  echo 'models: image + Whisper GGUF (LM Studio LLMs are managed in LM Studio)'
  echo "AI_HOME defaults to ~/Projects/AI"
}
case "${1:-help}" in
  models|lmcpp|sdcpp|comfyui|rocm|whisp) (( $# == 1 )) || err 'too many arguments'; "$1" ;;
  help|-h|--help) help ;;
  *) help; exit 2 ;;
esac
