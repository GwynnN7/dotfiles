# Register downloaded HF cache snapshots in the shared GGUF library.
# Hard links preserve the original cache and consume no additional model bytes
# on the same filesystem; we intentionally never move/delete cache blobs.
import_cached_models() {
  need python3
  local cache="$MODELS/.llama-cache" dest="$MODELS/llm"
  [[ -d "$cache" ]] || die "No llama.cpp cache at $cache"
  mkdir -p "$dest"
  python3 - "$cache" "$dest" <<'PY_CACHE_IMPORT'
import os
import re
import sys
from pathlib import Path

cache = Path(sys.argv[1]).resolve()
dest_root = Path(sys.argv[2]).resolve()
sidecar_prefixes = ('mmproj', 'mtp', 'eagle3', 'dflash', 'dspark')
linked = 0
already = 0
failures = 0
model_count = 0

def is_sidecar(name):
    return name.lower().startswith(sidecar_prefixes)

def shard_group(name):
    return re.sub(r'-\d{5}-of-\d{5}(?=\.gguf$)', '', name, flags=re.IGNORECASE)

def valid_gguf(path, repo):
    try:
        true_path = path.resolve(strict=True)
        # Don't import snapshot symlinks that point outside the cache repo.
        if not true_path.is_relative_to(repo.resolve()):
            print(f'[SKIP] Outside cache repo: {path}', file=sys.stderr)
            return False
        if not true_path.is_file() or true_path.stat().st_size < 4:
            return False
        with true_path.open('rb') as f:
            return f.read(4) == b'GGUF'
    except (OSError, RuntimeError):
        return False

def link_file(source, destination):
    global linked, already, failures
    try:
        if destination.exists() or destination.is_symlink():
            if destination.exists() and os.path.samefile(source, destination):
                already += 1
            else:
                print(f'[SKIP] Destination already exists: {destination}', file=sys.stderr)
                failures += 1
            return
        # Existing snapshot entries may be symlinks; link the actual blob.
        os.link(source.resolve(), destination)
        linked += 1
        print(f'[LINK] {destination.relative_to(dest_root)}')
    except OSError as exc:
        failures += 1
        print(f'[ERROR] Cannot hard-link {source.name}: {exc}', file=sys.stderr)
        print('        Hard links require source and destination on the same filesystem.', file=sys.stderr)

for repo in sorted(cache.glob('models--*')):
    snapshots = repo / 'snapshots'
    if not snapshots.is_dir():
        continue
    repo_id = repo.name.removeprefix('models--')
    # Use one directory per weight variant, so multimodal sidecars stay paired.
    for snap in sorted(snapshots.iterdir()):
        if not snap.is_dir():
            continue
        entries = sorted(p for p in snap.rglob('*')
                         if p.name.lower().endswith('.gguf') and p.is_file()
                         and valid_gguf(p, repo))
        primary = [p for p in entries if not is_sidecar(p.name)]
        sidecars = [p for p in entries if is_sidecar(p.name)]
        groups = {}
        for path in primary:
            groups.setdefault(shard_group(path.name), []).append(path)
        for name, components in sorted(groups.items()):
            folder = dest_root / f'{repo_id}--{Path(name).stem}'
            folder.mkdir(parents=True, exist_ok=True)
            model_count += 1
            for source in components + sidecars:
                link_file(source, folder / source.name)
        if len([p for p in sidecars if p.name.lower().startswith('mmproj')]) > 1:
            print(f'[WARN] Multiple mmproj files in {repo.name}; verify the intended projector.', file=sys.stderr)

print(f'Cache import: {model_count} model variant(s), {linked} new link(s), '
      f'{already} already present, {failures} conflict/error(s).')
if model_count == 0:
    print('No complete GGUF snapshots were found. Check models--*/snapshots/ in the cache.')
if failures:
    sys.exit(1)
PY_CACHE_IMPORT
}

list_models() {
  [[ -d "$MODELS" ]] || die "Shared model library missing: $MODELS"
  local file chosen=''
  if [[ -f "$MODEL_SELECTION" ]]; then IFS= read -r chosen < "$MODEL_SELECTION" || true; fi
  find "$MODELS" -type f \( -name '*.gguf' -o -name '*.safetensors' -o -name '*.bin' \) \
    ! -iname 'mmproj*' ! -iname 'mtp*' ! -iname 'eagle3*' \
    ! -iname 'dflash*' ! -iname 'dspark*' \
    ! -name '*.part' -print0 | sort -z | while IFS= read -r -d '' file; do
      local mark=' '
      [[ "$file" == "$MODELS/llm/$chosen" ]] && mark='*'
      printf ' %s %s\n' "$mark" "${file#"$MODELS/"}"
    done
}

status() {
  log "Workspace: $AI_HOME"
  local service pid
  for service in llamacpp llamacpp-hip comfyui sdcpp; do
    if pid="$(managed_pid "$service")"; then
      printf '  [running] %-14s PID %-8s http://127.0.0.1:%s\n' "$service" "$pid" "$(service_port "$service")"
    else
      printf '  [stopped] %s\n' "$service"
    fi
  done
  local app
  for app in \
    "$APPS/llama.cpp/build-vulkan/bin/llama-cli" \
    "$APPS/llama.cpp/build-hip/bin/llama-cli" \
    "$APPS/stable-diffusion.cpp/build-vulkan/bin/sd-cli" \
    "$APPS/whisper.cpp/build-hip/bin/whisper-cli"; do
    if [[ -x "$app" ]]; then printf '  [present] %s\n' "$app"; fi
  done
  printf '  Logs: %s\n' "$LOGS"
}

main() {
  (( $# > 0 )) || { usage; return; }
  local action="$1"; shift
  case "$action" in
    help|-h|--help) usage ;;
    start)
      (( $# >= 1 )) || die 'Usage: ai start <comfyui|sdcpp|llamacpp|llamacpp-hip>'
      action="$1"; shift
      start_service "$action" "$@" ;;
    stop)
      (( $# == 1 )) || die 'Usage: ai stop <comfyui|sdcpp|llamacpp|llamacpp-hip>'
      stop_service "$1" ;;
    ask) run_llama_ask "$@" ;;
    llamacpp|llama.cpp|lamacpp) run_llama_oneshot vulkan "$@" ;;
    llamacpp-hip) run_llama_oneshot hip "$@" ;;
    sdcpp|sd.cpp|stable-diffusion) run_sdcpp_oneshot "$@" ;;
    whispercpp|whisper.cpp) run_whispercpp "$@" ;;
    comfyui) die 'ComfyUI has no terminal one-shot command; use ai start comfyui and open its Web UI.' ;;
    model) model_command "$@" ;;
    models)
      if (( $# == 0 )); then
        list_models
      elif (( $# == 1 )) && [[ "$1" == import-cache ]]; then
        import_cached_models
      else
        die 'Usage: ai models [import-cache]'
      fi ;;
    env) (( $# == 0 )) || die 'Usage: ai env'; check_env ;;
    training)
      (( $# == 0 )) || die 'Usage: ai training'
      [[ -x "$ENVS/training/bin/python" ]] || die 'Training environment missing; use ai-install training'
      printf 'Fish: source %q\n' "$ENVS/training/bin/activate.fish" ;;
    status) (( $# == 0 )) || die 'Usage: ai status'; status ;;
    chat|install) die "'$action' is no longer part of this runtime CLI. Use ai <app> for single prompts; ai-install for installation." ;;
    *) die "Unknown command: $action (try ai help)" ;;
  esac
}
main "$@"
