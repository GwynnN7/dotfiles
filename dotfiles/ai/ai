#!/usr/bin/env bash
# Local AI runtime CLI for Arch/CachyOS + Radeon RX 6650 XT (gfx1032).
# Run directly from Fish or Bash: sudo install -m755 ai /usr/local/bin/ai
#
# SYSTEM DEPENDENCIES (managed separately; this script NEVER runs pacman):
#   bash, python, curl, coreutils, procps-ng (optional), fish (optional shell)
#   Vulkan: vulkan-radeon, vulkan-icd-loader, shaderc, spirv-headers
#   ROCm: TheRock gfx103X 10.1.0 under /opt/therock/10.1.0 (from ai-install)
#   Apps: ComfyUI, stable-diffusion.cpp, llama.cpp, whisper.cpp (from ai-install)
#   No Ollama, no additional model store, no installation side effects.
#
# Usage:
#   ai ask "one prompt"               Use running llama.cpp backend, else Vulkan CLI
#   ai llamacpp ["one prompt"]        Single prompt, uses Vulkan
#   ai llamacpp-hip ["one prompt"]    Single prompt, uses HIP
#   ai sdcpp ["image prompt"]         One image via sd-cli
#   ai whispercpp [file.wav] [flags]  One transcription (no server)
#   ai start <comfyui|sdcpp|llamacpp|llamacpp-hip> [flags]
#   ai stop <comfyui|sdcpp|llamacpp|llamacpp-hip>
#   ai model [name|reset]            Show/set default local GGUF
#   ai models import-cache           Register cache downloads without duplicating bytes
#   ai models | env | training | status | help
#
# Server process IDs and logs are kept under $AI_HOME/run/ and $AI_HOME/logs/.
# `ai stop` stops ONLY a service previously started and verified by this script.

set -Eeuo pipefail
IFS=$'\n\t'

AI_HOME="${AI_HOME:-$HOME/Projects/AI}"
APPS="$AI_HOME/apps"
MODELS="$AI_HOME/models"
ENVS="$AI_HOME/envs"
OUTPUTS="$AI_HOME/outputs"
CONFIG="$AI_HOME/config"
LOGS="$AI_HOME/logs"
RUNDIR="$AI_HOME/run"
MODEL_SELECTION="$CONFIG/default-model"
ROCM_DIR="/opt/therock/10.1.0"
LLAMA_PORT="${AI_LLAMA_PORT:-8080}"
COMFY_PORT="${AI_COMFY_PORT:-8188}"
SD_PORT="${AI_SD_PORT:-1234}"
GPU_ARCH=gfx1032

log() { printf '[AI] %s\n' "$*" >&2; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing system dependency: $1"; }

usage() {
  cat <<'TXT'
Local AI (RX 6650 XT, Arch/CachyOS, Fish-compatible)

One-shot terminal commands:
  ai ask "Explain CUDA blocks"          Use active llama.cpp router, else Vulkan CLI
  ai llamacpp "Explain GPU memory coalescing"  Answer using selected GGUF (Vulkan)
  ai llamacpp-hip "Say hello"            Same, using HIP
  echo 'Hello' | ai ask                  Prompt from stdin
  ai sdcpp "A mountain cabin at sunset" Generate an image with sd-cli
  ai whispercpp recording.wav -l it      Transcribe (auto language by default)

Background web servers (return to shell after startup):
  ai start llamacpp                   Router + Web UI, http://127.0.0.1:8080
  ai start llamacpp-hip               Same router, HIP backend (same port)
  ai start comfyui [--lowvram]        ComfyUI, http://127.0.0.1:8188
  ai start sdcpp                      SD.cpp Web UI, http://127.0.0.1:1234
  ai stop <app>                       Stop ONLY an ai-managed server, freeing VRAM

Utilities:
  ai model [name|reset]               Show/set default GGUF for one-shot prompts
  AI_MAX_TOKENS=1536 ai ask "..."     Set the maximum generated tokens
  ai models                           List shared local models
  ai models import-cache              Hard-link cached GGUFs into models/llm/ (no copy)
  ai env                              Validate ROCm and the PyTorch venv
  ai training                         Show training venv location
  ai status                           Show applications and managed servers
  ai help

ComfyUI has no one-shot terminal CLI: use `ai start comfyui`.
whisper.cpp has no server here: use `ai whispercpp <audio.wav>`.
No interactive chat, no CLI model switching during a conversation.
No Ollama. Models only from $AI_HOME/models (default: ~/Projects/AI/models).
Install programs separately using `ai-install <component>`.
Server logs: $AI_HOME/logs/    Server PID files: $AI_HOME/run/
TXT
}

make_runtime_dirs() {
  mkdir -p "$CONFIG" "$LOGS" "$RUNDIR" "$OUTPUTS/images" "$OUTPUTS/audio" "$MODELS/.llama-cache"
}

clean_gpu_env() {
  env -u HSA_OVERRIDE_GFX_VERSION -u PYTORCH_ROCM_ARCH \
      -u HSA_ENABLE_SDMA -u HSA_NO_SCRATCH_VRAM \
      -u PYTORCH_HIP_ALLOC_CONF -u LD_LIBRARY_PATH \
      ROCM_PATH="$ROCM_DIR" ROCM_HOME="$ROCM_DIR" HIP_PATH="$ROCM_DIR" "$@"
}

local_ggufs() {
  [[ -d "$MODELS/llm" ]] || return 0
  find "$MODELS/llm" -type f -iname '*.gguf' \
    ! -iname 'mmproj*' ! -iname 'mtp*' ! -iname 'eagle3*' \
    ! -iname 'dflash*' ! -iname 'dspark*' ! -name '*.part' -print0 | sort -z
}

resolve_model() {
  local query="$1" file rel base matches=0 candidate=''
  [[ -n "$query" ]] || die 'Provide a GGUF name or unique prefix (ai models)'
  while IFS= read -r -d '' file; do
    rel="${file#"$MODELS/llm/"}"
    base="${file##*/}"
    if [[ "$query" == "$rel" || "$query" == "$file" ]]; then
      printf '%s\n' "$rel"; return 0
    fi
    if [[ "$query" == "$base" ]]; then candidate="$rel"; ((matches+=1)); fi
  done < <(local_ggufs)
  if (( matches == 1 )); then printf '%s\n' "$candidate"; return 0; fi
  (( matches == 0 )) || die "Ambiguous GGUF filename '$query'"
  matches=0
  local query_lc="${query,,}" rel_lc base_lc
  while IFS= read -r -d '' file; do
    rel="${file#"$MODELS/llm/"}"
    base="${file##*/}"
    rel_lc="${rel,,}"; base_lc="${base,,}"
    if [[ "$rel_lc" == "$query_lc"* || "$base_lc" == "$query_lc"* ]]; then
      candidate="$rel"; ((matches+=1))
    fi
  done < <(local_ggufs)
  (( matches > 0 )) || die "No GGUF matches '$query' under $MODELS/llm"
  (( matches == 1 )) || die "Ambiguous model '$query' ($matches matches); specify full filename"
  printf '%s\n' "$candidate"
}

selected_model() {
  local rel='' file
  if [[ -f "$MODEL_SELECTION" ]]; then
    IFS= read -r rel < "$MODEL_SELECTION" || true
    while IFS= read -r -d '' file; do
      if [[ "$rel" == "${file#"$MODELS/llm/"}" ]]; then
        printf '%s\n' "$rel"; return 0
      fi
    done < <(local_ggufs)
    warn 'Saved model is missing; using first local GGUF.'
  fi
  file=''
  IFS= read -r -d '' file < <(local_ggufs) || true
  [[ -n "$file" ]] || die "No GGUF in $MODELS/llm. Use ai-install models."
  printf '%s\n' "${file#"$MODELS/llm/"}"
}

model_command() {
  (( $# <= 1 )) || die 'Usage: ai model [name|reset]'
  if (( $# == 0 )); then
    local chosen; chosen="$(selected_model)"
    printf 'Default GGUF: %s\nPath: %s\n' "$chosen" "$MODELS/llm/$chosen"
    return
  fi
  if [[ "$1" == reset ]]; then
    rm -f -- "$MODEL_SELECTION"
    log 'Default model cleared; the first local GGUF will be used.'
    return
  fi
  local chosen; chosen="$(resolve_model "$1")"
  make_runtime_dirs
  printf '%s\n' "$chosen" > "$MODEL_SELECTION.tmp.$$"
  mv -f -- "$MODEL_SELECTION.tmp.$$" "$MODEL_SELECTION"
  log "Default GGUF: $chosen"
}

# One-shot prompts: CLI argument(s), a pipe, or a single interactive prompt.
read_one_prompt() {
  local input=''
  if (( $# > 0 )); then
    local IFS=' '
    input="$*"
  elif [[ ! -t 0 ]]; then
    input="$(cat)"
  else
    printf 'Prompt> ' >&2
    IFS= read -r input || true
  fi
  [[ -n "$input" ]] || die 'Empty prompt; use ai ask "your question"'
  printf '%s' "$input"
}

# Managed server accounting: never terminate an unrelated service or reused PID.
service_marker() {
  case "$1" in
    llamacpp) printf '%s\n' "$APPS/llama.cpp/build-vulkan/bin/llama-server" ;;
    llamacpp-hip) printf '%s\n' "$APPS/llama.cpp/build-hip/bin/llama-server" ;;
    sdcpp) printf '%s\n' "$APPS/stable-diffusion.cpp/build-vulkan/bin/sd-server" ;;
    comfyui) printf '%s\n' "$APPS/ComfyUI/main.py" ;;
    *) return 1 ;;
  esac
}
service_port() {
  case "$1" in
    llamacpp|llamacpp-hip) printf '%s\n' "$LLAMA_PORT" ;;
    sdcpp) printf '%s\n' "$SD_PORT" ;;
    comfyui) printf '%s\n' "$COMFY_PORT" ;;
    *) return 1 ;;
  esac
}
service_pidfile() { printf '%s/%s.pid\n' "$RUNDIR" "$1"; }

pid_matches_service() {
  local pid="$1" service="$2" marker
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  marker="$(service_marker "$service")" || return 1
  # Match one complete NUL-delimited argument (not a substring).
  tr '\0' '\n' < "/proc/$pid/cmdline" | grep -Fqx -- "$marker"
}
managed_pid() {
  local service="$1" file pid
  file="$(service_pidfile "$service")"
  [[ -f "$file" ]] || return 1
  IFS= read -r pid < "$file" || return 1
  if pid_matches_service "$pid" "$service"; then
    printf '%s\n' "$pid"; return 0
  fi
  warn "Ignoring stale/unrecognized PID file for $service: $file"
  rm -f -- "$file"
  return 1
}

port_in_use() {
  local port="$1"
  need python3
  python3 - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
try:
    with socket.create_connection(('127.0.0.1', port), timeout=0.4):
        sys.exit(0)
except OSError:
    sys.exit(1)
PY
}

service_ready() {
  local service="$1" port
  port="$(service_port "$service")"
  case "$service" in
    llamacpp|llamacpp-hip)
      curl --noproxy '*' -fsS --max-time 2 "http://127.0.0.1:$port/models" >/dev/null 2>&1 ;;
    comfyui)
      curl --noproxy '*' -fsS --max-time 2 "http://127.0.0.1:$port/system_stats" >/dev/null 2>&1 ;;
    sdcpp)
      port_in_use "$port" ;;
  esac
}

start_service() {
  local service="$1"; shift
  service_marker "$service" >/dev/null || die "Unsupported server: $service (whispercpp has no server)"
  make_runtime_dirs
  local port pid file logfile marker
  port="$(service_port "$service")"
  file="$(service_pidfile "$service")"
  logfile="$LOGS/$service.log"
  marker="$(service_marker "$service")"
  if pid="$(managed_pid "$service")"; then
    log "$service is already running (PID $pid): http://127.0.0.1:$port"
    return
  fi
  if port_in_use "$port"; then
    die "Port $port is already occupied. Stop the existing server first; no process was killed."
  fi
  local -a cmd=()
  case "$service" in
    llamacpp|llamacpp-hip)
      (( $# == 0 )) || die "Usage: ai start $service"
      [[ -x "$marker" ]] || die "Missing $marker. Install with ai-install $service."
      cmd=("$marker" --models-dir "$MODELS/llm" --models-max 1 \
          --host 127.0.0.1 --port "$port" -ngl 99 -c 4096)
      ;;
    comfyui)
      [[ -x "$APPS/ComfyUI/.venv/bin/python" ]] || die 'ComfyUI missing; use ai-install comfyui'
      [[ -f "$marker" ]] || die "Missing ComfyUI entrypoint: $marker"
      cmd=("$APPS/ComfyUI/.venv/bin/python" "$marker" \
          --listen 127.0.0.1 --port "$port" \
          --models-directory "$MODELS" --output-directory "$OUTPUTS/images" \
          --force-fp16 --enable-manager "$@")
      ;;
    sdcpp)
      [[ -x "$marker" ]] || die 'sd-server missing; use ai-install sdcpp'
      cmd=("$marker" --model-dir "$MODELS" --listen-ip 127.0.0.1 --listen-port "$port" "$@")
      ;;
  esac
  log "Starting $service on http://127.0.0.1:$port (log: $logfile)"
  if [[ "$service" == comfyui ]]; then
    (cd "$APPS/ComfyUI"; nohup env -u HSA_OVERRIDE_GFX_VERSION \
       -u PYTORCH_ROCM_ARCH -u HSA_ENABLE_SDMA -u HSA_NO_SCRATCH_VRAM \
       -u PYTORCH_HIP_ALLOC_CONF -u LD_LIBRARY_PATH \
       ROCM_PATH="$ROCM_DIR" ROCM_HOME="$ROCM_DIR" HIP_PATH="$ROCM_DIR" \
       "${cmd[@]}" </dev/null >"$logfile" 2>&1 & echo $! > "$file")
  elif [[ "$service" == llamacpp-hip ]]; then
    nohup env -u HSA_OVERRIDE_GFX_VERSION -u PYTORCH_ROCM_ARCH \
      -u HSA_ENABLE_SDMA -u HSA_NO_SCRATCH_VRAM -u PYTORCH_HIP_ALLOC_CONF \
      -u LD_LIBRARY_PATH ROCM_PATH="$ROCM_DIR" ROCM_HOME="$ROCM_DIR" HIP_PATH="$ROCM_DIR" \
      LLAMA_CACHE="$MODELS/.llama-cache" "${cmd[@]}" </dev/null >"$logfile" 2>&1 &
    echo "$!" > "$file"
  else
    LLAMA_CACHE="$MODELS/.llama-cache" nohup "${cmd[@]}" </dev/null >"$logfile" 2>&1 &
    echo "$!" > "$file"
  fi
  pid="$(cat "$file")"
  local i
  for (( i=0; i<240; i++ )); do
    if ! pid_matches_service "$pid" "$service"; then
      # nohup/env may not have exec'd the target on the first poll.
      if (( i < 12 )) && kill -0 "$pid" 2>/dev/null; then sleep 0.25; continue; fi
      rm -f -- "$file"
      die "$service exited during startup. See $logfile (last lines: tail -n 40 '$logfile')"
    fi
    if service_ready "$service"; then
      log "$service ready at http://127.0.0.1:$port (PID $pid)"
      return
    fi
    sleep 0.25
  done
  warn "$service is still running, but readiness was not confirmed; check $logfile"
  log "Use: ai stop $service"
}

stop_service() {
  local service="$1" pid file
  service_marker "$service" >/dev/null || die "Unsupported server: $service (whispercpp has no server)"
  (( $# == 1 )) || die "Usage: ai stop $service"
  file="$(service_pidfile "$service")"
  if ! pid="$(managed_pid "$service")"; then
    log "$service has no ai-managed running server. Nothing to stop."
    return
  fi
  log "Stopping $service (PID $pid). The server releases its loaded GPU models on shutdown."
  kill -TERM "$pid" 2>/dev/null || true
  local i
  for (( i=0; i<80; i++ )); do
    if ! pid_matches_service "$pid" "$service"; then
      rm -f -- "$file"
      log "$service stopped."
      return
    fi
    sleep 0.25
  done
  if pid_matches_service "$pid" "$service"; then
    warn "$service did not exit after SIGTERM; sending SIGKILL to this verified PID."
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f -- "$file"
}

# Resolve the selected GGUF to the router's ID; do not assume file names equal IDs.
llama_server_prompt() {
  local model_path="$1" prompt="$2" port="$3"
  need python3
  AI_LLM_MODEL="$model_path" AI_LLM_PROMPT="$prompt" AI_LLM_URL="http://127.0.0.1:$port" \
    python3 - <<'PY'
import json, os, pathlib, sys, urllib.request, urllib.error
root = os.path.realpath(os.environ['AI_LLM_MODEL'])
url = os.environ['AI_LLM_URL'].rstrip('/')
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
def get(url):
    with opener.open(url, timeout=10) as r:
        return json.load(r)
try:
    data = get(url + '/models')
    models = data.get('data', [])
    wanted = None
    for entry in models:
        args = entry.get('status', {}).get('args', [])
        model_arg = None
        for idx, arg in enumerate(args):
            if arg in ('--model', '-m') and idx + 1 < len(args):
                model_arg = args[idx + 1]
                break
            if isinstance(arg, str) and arg.startswith('--model='):
                model_arg = arg.split('=', 1)[1]
                break
        if model_arg and os.path.realpath(model_arg) == root:
            wanted = entry['id']
            break
        if (entry.get('id') == pathlib.Path(root).stem or
            entry.get('id') == pathlib.Path(root).name):
            wanted = entry['id']
            break
    if wanted is None:
        raise RuntimeError('Selected GGUF is not in this router. Try ai models or restart the server.')
    max_tokens = int(os.getenv('AI_MAX_TOKENS', '1024'))
    if max_tokens < 1:
        raise ValueError('AI_MAX_TOKENS must be a positive integer')
    payload = {
        'model': wanted,
        'messages': [{'role': 'user', 'content': os.environ['AI_LLM_PROMPT']}],
        'stream': False,
        'max_tokens': max_tokens,
        # A one-shot command should return an answer, not exhaust its limit thinking.
        # Unsupported template kwargs are generally ignored by non-reasoning models.
        'chat_template_kwargs': {'enable_thinking': False},
    }
    def complete(request_payload):
        req = urllib.request.Request(url + '/v1/chat/completions',
                                     data=json.dumps(request_payload).encode(),
                                     headers={'Content-Type': 'application/json'}, method='POST')
        with opener.open(req, timeout=600) as result:
            return json.load(result)
    answer = complete(payload)
    choices = answer.get('choices', [])
    msg = choices[0].get('message', {}) if choices else {}
    text = msg.get('content')
    if not isinstance(text, str):
        raise RuntimeError('Unexpected response from llama.cpp: ' + str(answer)[:300])
    if not text.strip():
        # Some reasoning templates ignore enable_thinking=False. Retry once with
        # the API-level reasoning switch when the model only returned thoughts.
        retry = dict(payload, reasoning_effort='none')
        answer = complete(retry)
        choices = answer.get('choices', [])
        msg = choices[0].get('message', {}) if choices else {}
        text = msg.get('content')
        if not isinstance(text, str):
            raise RuntimeError('Unexpected retry response: ' + str(answer)[:300])
        if not text.strip():
            reason = choices[0].get('finish_reason', '?') if choices else '?'
            has_reasoning = bool(msg.get('reasoning_content'))
            raise RuntimeError(
                f'No final answer returned (finish_reason={reason}, '
                f'reasoning_only={has_reasoning}). Try a larger token budget '
                f'(AI_MAX_TOKENS=2048 ai ask "...") or a different GGUF.')
    print(text, flush=True)
except urllib.error.HTTPError as e:
    detail = e.read().decode('utf-8', 'replace')[:500]
    print(f'[ERROR] llama.cpp HTTP {e.code}: {detail}', file=sys.stderr)
    sys.exit(1)
except (OSError, ValueError, urllib.error.URLError, RuntimeError) as e:
    print(f'[ERROR] llama.cpp request: {e}', file=sys.stderr)
    sys.exit(1)
PY
}

run_llama_oneshot() {
  local backend="$1"; shift
  local service='llamacpp'
  [[ "$backend" == hip ]] && service='llamacpp-hip'
  local rel model prompt binary server_pid other='llamacpp-hip'
  [[ "$backend" == hip ]] && other='llamacpp'
  rel="$(selected_model)"
  model="$MODELS/llm/$rel"
  prompt="$(read_one_prompt "$@")"
  if server_pid="$(managed_pid "$service")"; then
    log "Using running $service router (selected GGUF: $rel)"
    llama_server_prompt "$model" "$prompt" "$LLAMA_PORT"
    return
  fi
  # A router for the other backend can fill all 8 GB of VRAM; don't launch another model.
  if managed_pid "$other" >/dev/null; then
    die "$other server is running on port $LLAMA_PORT. Use ai $other or stop it first."
  fi
  if port_in_use "$LLAMA_PORT"; then
    die "Port $LLAMA_PORT is occupied by a server not managed by ai. Stop it manually or run ai start $service after it exits."
  fi
  binary="$APPS/llama.cpp/build-$backend/bin/llama-cli"
  [[ -x "$binary" ]] || die "Missing $binary; install using ai-install $service"
  log "Single-turn $backend inference: $rel"
  if [[ "$backend" == hip ]]; then
    LLAMA_CACHE="$MODELS/.llama-cache" clean_gpu_env "$binary" \
      -m "$model" -ngl 99 -c 4096 --single-turn --reasoning off \
      --no-display-prompt -p "$prompt" -n "${AI_MAX_TOKENS:-1024}"
  else
    LLAMA_CACHE="$MODELS/.llama-cache" "$binary" \
      -m "$model" -ngl 99 -c 4096 --single-turn --reasoning off \
      --no-display-prompt -p "$prompt" -n "${AI_MAX_TOKENS:-1024}"
  fi
}

# Auto-select the active managed llama.cpp router, with Vulkan CLI as fallback.
run_llama_ask() {
  local vulkan_pid='' hip_pid=''
  vulkan_pid="$(managed_pid llamacpp)" || true
  hip_pid="$(managed_pid llamacpp-hip)" || true
  if [[ -n "$vulkan_pid" && -n "$hip_pid" ]]; then
    die 'Both llama.cpp backends appear active; stop one with ai stop <backend>.'
  elif [[ -n "$hip_pid" ]]; then
    run_llama_oneshot hip "$@"
  elif [[ -n "$vulkan_pid" ]]; then
    run_llama_oneshot vulkan "$@"
  elif service_ready llamacpp; then
    # A manually started router may be usable even without an ai-managed PID.
    # We never take control of or stop unmanaged servers.
    local rel model prompt
    rel="$(selected_model)"
    model="$MODELS/llm/$rel"
    prompt="$(read_one_prompt "$@")"
    log "Using existing llama.cpp router (unmanaged): $rel"
    llama_server_prompt "$model" "$prompt" "$LLAMA_PORT"
  else
    run_llama_oneshot vulkan "$@"
  fi
}

run_sdcpp_oneshot() {
  local app="$APPS/stable-diffusion.cpp" binary model prompt out
  binary="$app/build-vulkan/bin/sd-cli"
  [[ -x "$binary" ]] || die "Missing $binary; use ai-install sdcpp"
  # AI_SD_MODEL may be a full path or a bare filename in models/checkpoints.
  if [[ -n "${AI_SD_MODEL:-}" ]]; then
    model="$AI_SD_MODEL"
    [[ -f "$model" ]] || model="$MODELS/checkpoints/$AI_SD_MODEL"
  elif [[ -f "$MODELS/checkpoints/DreamShaper_8_pruned.safetensors" ]]; then
    model="$MODELS/checkpoints/DreamShaper_8_pruned.safetensors"
  else
    model="$MODELS/checkpoints/v1-5-pruned-emaonly.safetensors"
  fi
  [[ -f "$model" ]] || die "No SD 1.x checkpoint found; use ai-install models or set AI_SD_MODEL."
  prompt="$(read_one_prompt "$@")"
  make_runtime_dirs
  out="$OUTPUTS/images/sdcpp-$(date +%Y%m%d-%H%M%S)-$$.png"
  if managed_pid sdcpp >/dev/null; then
    warn 'SD.cpp Web UI is running; the separate sd-cli process will compete for VRAM.'
  fi
  log "Generating 512x512 image → $out"
  "$binary" -m "$model" -p "$prompt" -W 512 -H 512 \
    --steps 28 --sampling-method dpm++2m --scheduler karras --cfg-scale 7 -o "$out"
  printf '%s\n' "$out"
}

run_whispercpp() {
  local binary="$APPS/whisper.cpp/build-hip/bin/whisper-cli"
  local model="$MODELS/whisper/ggml-base.bin"
  local audio="$APPS/whisper.cpp/samples/jfk.wav"
  [[ -x "$binary" ]] || die 'Missing whisper-cli; use ai-install whispercpp'
  [[ -f "$model" ]] || die 'Missing multilingual ggml-base.bin; use ai-install models'
  if (( $# > 0 )) && [[ "$1" != -* ]]; then audio="$1"; shift; fi
  [[ -f "$audio" ]] || die "Audio file missing: $audio"
  clean_gpu_env "$binary" -m "$model" -f "$audio" -l auto "$@"
}

check_env() {
  [[ -x "$ROCM_DIR/bin/hipcc" ]] || die 'TheRock HIP SDK missing; use ai-install env'
  "$ROCM_DIR/bin/hipcc" --version | head -n 2
  clean_gpu_env "$ROCM_DIR/bin/rocminfo" | grep -E 'gfx1032|AMD Radeon RX 6650 XT' || die 'gfx1032 not detected'
  local py="$ENVS/pytorch/bin/python"
  [[ -x "$py" ]] || die 'PyTorch venv missing; use ai-install env'
