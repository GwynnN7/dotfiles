#!/usr/bin/env bash
# Local services + CLIs. Requires bash, curl, python3; ffmpeg for transcription.
set -Eeuo pipefail
AI_HOME="${AI_HOME:-$HOME/Projects/AI}"
M="$AI_HOME/models"; A="$AI_HOME/apps"; RUN="$AI_HOME/run"; LOG="$AI_HOME/logs"
R="/opt/therock/10.1.0"; O="$AI_HOME/outputs"
err() { echo "ai: $*" >&2; exit 1; }
msg() { echo "[ai] $*" >&2; }
need() { command -v "$1" >/dev/null || err "missing: $1"; }
init() { mkdir -p "$RUN" "$LOG" "$O/images" "$O/audio"; }
rocm_env() { env -u HSA_OVERRIDE_GFX_VERSION -u PYTORCH_ROCM_ARCH ROCM_PATH="$R" ROCM_HOME="$R" HIP_PATH="$R" PATH="$R/bin:$PATH" "$@"; }
port() {
  case "$1" in lms) echo 1234;; sdcpp) echo 1235;; comfyui) echo 8188;; llamacpp) echo 8080;; llamacpp-hip) echo 8081;; esac
}
binary() {
  case "$1" in
    sdcpp) echo "$A/stable-diffusion.cpp/build-vulkan/bin/sd-server" ;;
    comfyui) echo "$A/ComfyUI/main.py" ;;
    llamacpp) echo "$A/llama.cpp/build-vulkan/bin/llama-server" ;;
    llamacpp-hip) echo "$A/llama.cpp/build-hip/bin/llama-server" ;;
  esac
}
pidfile() { echo "$RUN/$1.pid"; }
# Avoid killing an unrelated process after PID reuse.
running_pid() {
  local file pid mark
  file="$(pidfile "$1")"; [[ -f "$file" ]] || return 1
  read -r pid < "$file" || return 1
  mark="$(binary "$1")"
  if [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] &&
    tr '\0' '\n' < "/proc/$pid/cmdline" | grep -Fxq -- "$mark"; then
    printf '%s\n' "$pid"
    return 0
  fi
  rm -f -- "$file"; return 1
}
port_open() {
  python3 - "$1" <<'PY'
import socket,sys
try:
    with socket.create_connection(('127.0.0.1', int(sys.argv[1])), timeout=0.3): pass
except OSError: sys.exit(1)
PY
}
status() {
  local app="$1" pid p
  p="$(port "$app")"
  if [[ "$app" == lms ]]; then
    if curl -fsS --max-time 2 "http://127.0.0.1:$p/v1/models" >/dev/null 2>&1; then
      echo "lms: running (http://127.0.0.1:$p)"
    elif port_open "$p"; then echo "lms: port $p occupied (not verified)"
    else echo 'lms: stopped'; fi
  elif pid="$(running_pid "$app")"; then
    echo "$app: running (PID $pid, http://127.0.0.1:$p)"
  elif port_open "$p"; then echo "$app: unmanaged process on port $p"
  else echo "$app: stopped"; fi
}
start() {
  local app="$1" p marker pid i
  shift; p="$(port "$app")"
  if [[ "$app" == lms ]]; then
    need lms; exec lms server start --port "$p" --bind 127.0.0.1 "$@"
  fi
  marker="$(binary "$app")"; [[ -f "$marker" ]] || err "missing $app; run ai-install first"
  init
  if pid="$(running_pid "$app")"; then msg "$app running ($pid)"; return; fi
  port_open "$p" && err "port $p is already in use"
  local -a cmd=()
  case "$app" in
    sdcpp)
      cmd=("$marker" --model-dir "$M" --listen-ip 127.0.0.1 --listen-port "$p" "$@") ;;
    comfyui)
      [[ -x "$A/ComfyUI/.venv/bin/python" ]] || err 'missing ComfyUI venv'
      cmd=("$A/ComfyUI/.venv/bin/python" "$marker" --listen 127.0.0.1 --port "$p" --extra-model-paths-config "$A/ComfyUI/extra_model_paths.yaml" --output-directory "$O/images" --enable-manager "$@") ;;
    llamacpp|llamacpp-hip)
      [[ -d "$M/lmstudio" ]] || err 'LM Studio model directory missing'
      cmd=("$marker" --models-dir "$M/lmstudio" --models-max 1 --host 127.0.0.1 --port "$p" -ngl 99 -c 4096 "$@") ;;
  esac
  # nohup retains the actual service PID; the CLI never kills unowned PIDs.
  (
    [[ "$app" != comfyui ]] || cd "$A/ComfyUI"
    if [[ "$app" == comfyui || "$app" == llamacpp-hip ]]; then
      exec nohup env -u HSA_OVERRIDE_GFX_VERSION -u PYTORCH_ROCM_ARCH \
        ROCM_PATH="$R" ROCM_HOME="$R" HIP_PATH="$R" PATH="$R/bin:$PATH" "${cmd[@]}"
    else exec nohup "${cmd[@]}"; fi
  ) >"$LOG/$app.log" 2>&1 </dev/null &
  pid=$!; echo "$pid" > "$(pidfile "$app")"
  for ((i=0; i<80; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f -- "$(pidfile "$app")"; err "$app failed: $LOG/$app.log"
    fi
    if port_open "$p"; then status "$app"; return; fi
    sleep .25
  done
  msg "$app launched, not yet listening. See $LOG/$app.log"
}
stop() {
  local app="$1" pid i
  if [[ "$app" == lms ]]; then need lms; exec lms server stop; fi
  if ! pid="$(running_pid "$app")"; then msg "$app not managed/running"; return; fi
  kill -TERM "$pid" 2>/dev/null || true
  for ((i=0; i<60; i++)); do
    if ! running_pid "$app" >/dev/null; then rm -f -- "$(pidfile "$app")"; msg "$app stopped"; return; fi
    sleep .2
  done
  if running_pid "$app" >/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
  rm -f -- "$(pidfile "$app")"
}
resolve_llm() {
  local chosen="$1" file
  if [[ -f "$chosen" ]]; then printf '%s\n' "$chosen"; return; fi
  local -a matches=()
  while IFS= read -r -d '' file; do matches+=("$file"); done < <(
    find "$M/lmstudio" -type f -name "${chosen}*.gguf" ! -name 'mmproj*' -print0 2>/dev/null)
  (( ${#matches[@]} == 1 )) || err "model '$chosen' has ${#matches[@]} matches; use an exact path"
  printf '%s\n' "${matches[0]}"
}
llama_cli() {
  local app="$1" act="${2:-}" exe model
  shift; (( $# )) && shift || true
  if [[ "$app" == llamacpp ]]; then exe="$A/llama.cpp/build-vulkan/bin/llama-cli"
  else exe="$A/llama.cpp/build-hip/bin/llama-cli"; fi
  [[ -x "$exe" ]] || err "missing $exe"
  case "$act" in
    cli) if [[ "$app" == llamacpp-hip ]]; then rocm_env "$exe" "$@"; else "$exe" "$@"; fi ;;
    chat|prompt)
      (( $# >= 1 )) || err "usage: ai $app $act MODEL [prompt/options]"
      model="$(resolve_llm "$1")"; shift
      local -a args=(-m "$model" -ngl 99 -c 4096)
      if [[ "$act" == prompt ]]; then
        (( $# >= 1 )) || err 'missing prompt'
        args+=(-p "$1"); shift
      fi
      if [[ "$app" == llamacpp-hip ]]; then rocm_env "$exe" "${args[@]}" "$@"
      else "$exe" "${args[@]}" "$@"; fi ;;
    *) if [[ -z "$act" ]]; then act='--help'; fi
       if [[ "$app" == llamacpp-hip ]]; then rocm_env "$exe" "$act" "$@"
       else "$exe" "$act" "$@"; fi ;;
  esac
}
sd_cli() {
  local exe="$A/stable-diffusion.cpp/build-vulkan/bin/sd-cli" action="${1:-}" model prompt out
  [[ -x "$exe" ]] || err 'missing sd-cli: ai-install sdcpp'
  (( $# )) && shift || true
  if [[ "$action" == gen ]]; then
    (( $# >= 2 )) || err 'usage: ai sdcpp gen {dreamshaper|sd15|sdxl|anima|zimage} "prompt" [sd-cli args]'
    model="$1"; prompt="$2"; shift 2
    local -a opts=()
    case "$model" in
      dreamshaper) opts=(--model "$M/checkpoints/haven-ai-companion/dreamshaper8-lcm-gguf/DreamShaper8_LCM_q8_0.gguf" --sampling-method lcm --steps 8 --cfg-scale 2 -W 512 -H 512) ;;
      sd15) opts=(--model "$M/checkpoints/stable-diffusion-v1-5/stable-diffusion-v1-5/v1-5-pruned-emaonly.safetensors" --sampling-method euler_a --steps 25 --cfg-scale 7 -W 512 -H 512) ;;
      sdxl) opts=(--model "$M/checkpoints/stabilityai/stable-diffusion-xl-base-1.0/sd_xl_base_1.0.safetensors" --sampling-method dpm++2m --steps 25 --cfg-scale 6 -W 768 -H 768) ;;
      anima) opts=(--diffusion-model "$M/diffusion_models/JoyFusionAI/gguf-anima/anima-turbo-v1.1-Q4_0.gguf" --llm "$M/text_encoders/JoyFusionAI/gguf-components/Qwen3-0.6B-Base.Q8_0.gguf" --vae "$M/vae/JoyFusionAI/gguf-components/qwen_image_vae.safetensors" --sampling-method euler --steps 8 --cfg-scale 1 -W 512 -H 512) ;;
      zimage) opts=(--diffusion-model "$M/diffusion_models/leejet/Z-Image-Turbo-GGUF/z_image_turbo-Q3_K.gguf" --llm "$M/text_encoders/JoyFusionAI/gguf-components/Qwen3-4B-Instruct-2507-Q4_0.gguf" --vae "$M/vae/JoyFusionAI/gguf-components/ae.safetensors" --sampling-method euler --steps 9 --cfg-scale 1 -W 768 -H 768) ;;
      *) err "unknown image model: $model" ;;
    esac
    init; out="$O/images/$model-$(date +%Y%m%d-%H%M%S).png"
    "$exe" "${opts[@]}" -p "$prompt" -o "$out" "$@"
    echo "$out"
  elif [[ "$action" == cli ]]; then "$exe" "$@"
  elif [[ -n "$action" ]]; then "$exe" "$action" "$@"
  else "$exe" --help; fi
}
transcribe() (
  local exe="$A/transcribe.cpp/build-vulkan/bin/transcribe-cli" audio model='large-v3-turbo' tmp
  [[ -x "$exe" ]] || err 'missing transcribe.cpp: ai-install whisp'
  (( $# >= 1 )) || err 'usage: ai transcribe AUDIO [--model small|medium|turbo|PATH] [CLI flags]'
  audio="$1"; shift; [[ -f "$audio" ]] || err "file not found: $audio"
  local -a args=()
  while (( $# )); do
    case "$1" in
      --model|-m)
        (( $# >= 2 )) || err 'missing --model value'
        model="$2"; shift 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  case "$model" in
    small) model='whisper-small-gguf/whisper-small-Q8_0.gguf' ;;
    medium) model='whisper-medium-gguf/whisper-medium-Q8_0.gguf' ;;
    turbo|large-v3-turbo) model='whisper-large-v3-turbo-gguf/whisper-large-v3-turbo-Q8_0.gguf' ;;
    *) [[ "$model" = /* || "$model" = ./* || "$model" = ../* ]] || err 'unknown --model value' ;;
  esac
  [[ "$model" == /* || "$model" == ./* || "$model" == ../* ]] || model="$M/whisper/$model"
  [[ -f "$model" ]] || err "missing model: $model (ai-install models)"
  need ffmpeg; tmp="$(mktemp --suffix=.wav)"; trap 'rm -f -- "$tmp"' EXIT
  ffmpeg -v error -nostdin -y -i "$audio" -ar 16000 -ac 1 -c:a pcm_s16le "$tmp"
  "$exe" -m "$model" --backend vulkan "${args[@]}" "$tmp"
)
help() {
  cat <<'HELP'
ai APP {start|stop|status} [server flags]    APP=lms|llamacpp|llamacpp-hip|comfyui|sdcpp
ai lms {chat|ls|get|load|unload|ps|server|...} ...    All `lms` CLI commands
ai llamacpp[-hip] {chat MODEL|prompt MODEL "text"|cli [flags]}
ai sdcpp gen {dreamshaper|sd15|sdxl|anima|zimage} "prompt" [sd-cli flags]
ai sdcpp cli [sd-cli flags]       Full sd-cli passthrough
ai transcribe AUDIO [--model small|medium|turbo|PATH] [--language it] [CLI flags]
ai status                        All servers
HELP
}
main() {
  local app="${1:-help}" action="${2:-}"
  (( $# )) && shift || true
  case "$app" in
    help|-h|--help) help ;;
    status) for app in lms llamacpp llamacpp-hip comfyui sdcpp; do status "$app"; done ;;
    transcribe) transcribe "$@" ;;
    lms|llamacpp|llamacpp-hip|comfyui|sdcpp)
      (( $# )) && shift || true
      case "$action" in
        start) start "$app" "$@" ;;
        stop) (( $# == 0 )) || err 'stop takes no additional arguments'; stop "$app" ;;
        status) status "$app" ;;
        *) case "$app" in
             lms) need lms; if [[ -n "$action" ]]; then exec lms "$action" "$@"; else exec lms; fi ;;
             llamacpp|llamacpp-hip) llama_cli "$app" "$action" "$@" ;;
             sdcpp) sd_cli "$action" "$@" ;;
             comfyui) err 'ComfyUI has no native CLI here; use start|stop|status' ;;
           esac ;;
      esac ;;
    *) help; exit 2 ;;
  esac
}
main "$@"
