#!/usr/bin/env bash
# Arch Linux / CachyOS, AMD Radeon RX 6650 XT (gfx1032), Fish shell.
# Usage:
#   ai install <env|models|models-xl|comfyui|sdcpp|llamacpp|llamacpp-hip|whispercpp|training|all>
#   ai <comfyui|sdcpp|llamacpp|llamacpp-hip|whispercpp> [optional arguments]
#   ai chat [model]         Interactive terminal chat (starts a local router if needed)
#   ai model [name]         Get or set your default GGUF model
#   ai env                 Validate ROCm and PyTorch (read-only)
#   ai models              List available local models (read-only)
#   ai training            Show training environment instructions (read-only)
#   ai status              Show installation status (read-only)
#   ai help

set -Eeuo pipefail
IFS=$'\n\t'

AI_HOME="${AI_HOME:-$HOME/Projects/AI}"
APPS="$AI_HOME/apps"
MODELS="$AI_HOME/models"
ENVS="$AI_HOME/envs"
OUTPUTS="$AI_HOME/outputs"
CACHE="$AI_HOME/cache/downloads"
CONFIG="$AI_HOME/config"
LOGS="$AI_HOME/logs"
MODEL_SELECTION="$CONFIG/default-model"
LLAMA_PORT="${AI_LLAMA_PORT:-8080}"
ROCM_VERSION="10.1.0"
ROCM_DIR="/opt/therock/$ROCM_VERSION"
ROCM_URL="https://stable.repo.amd.com/rocm/core/tarball/therock-dist-linux-gfx103X-all-10.1.0.tar.gz"
PYTORCH_INDEX="https://stable.repo.amd.com/rocm/whl-next/"
PYTORCH_VERSION="2.13.0+rocm10.1.0"
TORCHVISION_VERSION="0.28.0+rocm10.1.0"
GPU_ARCH="gfx1032"
PYTHON_CMD="${PYTHON_CMD:-python3}"

log() { printf '\n\033[1;36m[AI]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; exit 1; }
trap 'printf "\n[ERROR] Command failed at line %s. Review the error above.\n" "$LINENO" >&2' ERR
need() { command -v "$1" >/dev/null 2>&1 || die "Missing system dependency: $1 (see package comments at top)."; }

usage() {
  cat <<'TXT'
AI workspace command for Arch/CachyOS + AMD RX 6650 XT (gfx1032).

Install components (downloads/builds may be substantial):
  ai install env           Shared folders, TheRock 10.1 SDK, Fish config, PyTorch test venv
  ai install models        SD 1.5, DreamShaper 8, Qwen3.5 4B Q4, Whisper base
  ai install models-xl     Optional SDXL Base 1.0 checkpoint (~7 GB)
  ai install comfyui       ComfyUI with ROCm PyTorch + Manager
  ai install sdcpp         stable-diffusion.cpp Vulkan CLI + Web UI
  ai install llamacpp      llama.cpp Vulkan
  ai install llamacpp-hip  Separate llama.cpp HIP build (experimental)
  ai install whispercpp    whisper.cpp HIP build (experimental)
  ai install training      Transformers + PEFT training venv (not Unsloth)
  ai install all           Environment, models, ComfyUI, SD.cpp, llama.cpp, Whisper

Launch already-installed applications:
  ai comfyui [flags...]    ComfyUI Web UI, http://127.0.0.1:8188
  ai sdcpp [flags...]      SD.cpp Web UI, http://127.0.0.1:1234
  ai llamacpp             Vulkan multi-model router server, http://127.0.0.1:8080
  ai llamacpp-hip         HIP multi-model router server, same port
  ai chat [model]         Interactive terminal chat (auto-starts Vulkan server if absent)
  ai model [name]         Show or select persistent default local GGUF
  ai model reset          Clear the saved default GGUF; use first local model
  ai whispercpp [audio.wav]  Transcribe supplied WAV or included sample

Inspect without installing:
  ai env                   Validate native gfx1032 HIP and ROCm PyTorch
  ai models                List downloaded model files (selected default marked)
  ai models-xl             Check whether the optional SDXL model exists
  ai training              Check venv and print how to activate it
  ai status                Report installed programs and model files
