#!/usr/bin/env bash

if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    SESSION_TYPE="hyprland"
else
    SESSION_TYPE="steamos"
fi

GAME_CMD=()
GAME_ENV=(
    "PROTON_LOCAL_SHADER_CACHE=1"
    "PROTON_DISCORD_BRIDGE=1"
)

GOVERLAY="${GR_GOVERLAY:-0}"
GAMESCOPE="${GR_SCOPE:-0}"
WAYLAND="${GR_WAYLAND:-0}"
LATENCY="${GR_LATENCY:-0}"
HDR="${GR_HDR:-0}"
ZINK="${GR_ZINK:-0}"
FSR_WATERMARK="${GR_FSR_WATERMARK:-0}"

case "${GR_NVAPI:-}" in
    1|true)  NVAPI_STATUS=2 ;;
    0|false) NVAPI_STATUS=1 ;;
    *)       NVAPI_STATUS=0 ;;
esac

case "${GR_MANGO:-}" in
    2)       MANGOHUD_TYPE=2 ;;
    1)       MANGOHUD_TYPE=1 ;;
    *)       MANGOHUD_TYPE=0 ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in 
        --mangohud) MANGOHUD_TYPE=1; shift ;;
        --mangoapp) MANGOHUD_TYPE=2; shift ;;
        --nvapi)    NVAPI_STATUS=1; shift ;;
        --no-nvapi) NVAPI_STATUS=2; shift ;;
        --gamescope) GAMESCOPE=1; shift ;;
        --wayland)   WAYLAND=1; shift ;;

        --) shift; GAME_CMD+=("$@"); break ;;
        *) GAME_CMD+=("$@"); break ;;
    esac
done

if [[ ${#GAME_CMD[@]} -eq 0 ]]; then
    echo "Error: No game executable provided."
    exit 1
fi

if [[ "$SESSION_TYPE" == "steamos" ]]; then
    WAYLAND=0
    GAMESCOPE=0
    if [[ $MANGOHUD_TYPE -eq 2 ]]; then
        MANGOHUD_TYPE=1
    fi
fi

if [[ $WAYLAND -eq 1 ]]; then
    GAME_ENV+=("PROTON_ENABLE_WAYLAND=1")
else
    GAME_ENV+=("PROTON_ENABLE_WAYLAND=0")
fi

if [[ $HDR -eq 1 ]]; then
    GAME_ENV+=("DXVK_HDR=1")
else
    GAME_ENV+=("DXVK_NO_HDR=1")
fi

if [[ $ZINK -eq 1 ]]; then
    GAME_ENV+=("MESA_LOADER_DRIVER_OVERRIDE=zink")
fi

if [[ $FSR_WATERMARK -eq 1 ]]; then
    GAME_ENV+=("PROTON_FSR4_INDICATOR=1")
fi

case "$LATENCY" in
    1)
        GAME_ENV+=("LOW_LATENCY_LAYER=1" "LOW_LATENCY_LAYER_REFLEX=1")
        ;;
    2)
        GAME_ENV+=("PROTON_DXVK_LOWLATENCY=1")
        ;;
    3)
        GAME_ENV+=("PROTON_VKD3D_LOWLATENCY=1")
        ;;
    4)
        GAME_ENV+=("LOW_LATENCY_LAYER=1")
        ;;
esac

case "$NVAPI_STATUS" in
    1) GAME_ENV+=("PROTON_FORCE_NVAPI=1") ;;
    2) GAME_ENV+=("PROTON_DISABLE_NVAPI=1") ;;
esac

WRAPPER=()
if [[ $MANGOHUD_TYPE -eq 1 ]]; then
    WRAPPER+=(mangohud)
fi

WRAPPER+=("${GAME_CMD[@]}")
LAUNCH_CMD=()

if [[ $GAMESCOPE -eq 1 ]]; then
    CURRENT_HZ=$(hyprctl monitors -j 2>/dev/null | jq '.[] | select(.focused) | .refreshRate | round' 2>/dev/null)
    if [[ -z "$CURRENT_HZ" ]]; then
        CURRENT_HZ="60"
    fi

    GAMESCOPE_ARGS=(
        -W 1920 -H 1080 -f -r "$CURRENT_HZ" --adaptive-sync
    )

    if [[ $MANGOHUD_TYPE -eq 2 ]]; then
        GAMESCOPE_ARGS+=("--mangoapp")
    fi

    LAUNCH_CMD+=(gamescope "${GAMESCOPE_ARGS[@]}" --)
fi

if [[ $GOVERLAY -eq 1 ]]; then
    LAUNCH_CMD+=("$HOME/.local/share/goverlay/gameconfig/global/bgmod" --)
fi

LAUNCH_CMD+=(env "${GAME_ENV[@]}" "${WRAPPER[@]}")
exec booster "${LAUNCH_CMD[@]}"
